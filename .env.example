# Copy to .env and fill in. Never commit .env.

# Leave empty to use a local SQLite file (data/local.db).
# For Supabase: Project Settings -> Database -> Connection string (URI, "Session pooler").
DATABASE_URL=

# Google AI Studio -> Get API key
GEMINI_API_KEY=
# Models tried in order, comma-separated. Leave empty for the default list in core/llm.py.
GEMINI_MODEL=

# console.groq.com -> API Keys (backup LLM)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# reddit.com/prefs/apps -> create "script" app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=brand-consultant/0.1 by u/your_username

# Gmail alerts: Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Who receives alerts; defaults to GMAIL_ADDRESS
ALERT_TO=
